# Remove the line below if you want to inherit .editorconfig settings from higher directories
root = true

[*]
charset = utf-8

[*.cs]

# IDE0320: Make anonymous function static
csharp_prefer_static_anonymous_function = false
# CS8618: Non-nullable field must contain a non-null value when exiting constructor. Consider adding the "required" modifier or declaring it as nullable.
dotnet_diagnostic.CS8618.severity = suggestion
# IDE0305: Simplify collection initialization with [.. ]
dotnet_diagnostic.IDE0305.severity = none
# CS8524: The switch expression does not handle some values of its input type (it is not exhaustive) involving an unnamed enum value.
dotnet_diagnostic.CS8524.severity = suggestion

[*.{cs,vb}]

# IDE0028: Simplify collection initialization
dotnet_style_collection_initializer = true:silent
# IDE0130: Namespace does not match folder structure
dotnet_diagnostic.IDE0130.severity = silent
